int maxArea(int* height, int heightSize) {
    int left=0;
    int right =heightSize-1;
    int maxArea=INT_MIN,area,temp;

    while(left<right){
        temp = (height[left]<height[right])? height[left]:height[right];
        area = temp * (right-left);
        if(maxArea<area){
            maxArea=area;
        }
        if(height[left]<height[right]){
            left++;
        }
        else{
            right--;
        }
    }
    return maxArea;
}
int getValue(const char * s){
    switch(*s) {
        case 'I': return (s[1] == 'V' || s[1] == 'X') ? -1 : 1;
        case 'X': return (s[1] == 'L' || s[1] == 'C') ? -10 : 10;
        case 'C': return (s[1] == 'D' || s[1] == 'M') ? -100 : 100;
        case 'V': return 5;
        case 'L': return 50;
        case 'D': return 500;
        case 'M': return 1000;
    }
    return 0;
}

int romanToInt(char * s){
    int result = 0; 
    
    for(;*s != '\0'; ++s) {
        result += getValue(s);
    }
    return result;
}

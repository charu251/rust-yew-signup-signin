bool isValid(char* s) {
    int last_seen             = 0;
    int curly_bracket_fifo    = 0;
    int square_bracket_fifo   = 0;
    int regular_bracket_fifo  = 0;
    int str_length =  strlen (s);
    char * correct_order = (char *) malloc (str_length * sizeof(int)); 
    int j =0;

    for (int i =0 ; i < str_length; i++ ) {
        if (s[i] == '{') {
            curly_bracket_fifo++;
            correct_order[j] =  CURLY_LAST_SEEN;
            j++;
        }
        if (s[i] == '(') {
            regular_bracket_fifo++;
            correct_order[j]  = REGULAR_LAS_SEEN;
            j++;
        }
        if (s[i] == '[') {
            square_bracket_fifo++;
            correct_order[j]  = SQUARE_LAST_SEEN;
            j++;
        }
        
        if (s[i] == '}') {
            j--;
            if (j<0) return 0;
            if (correct_order[j] != CURLY_LAST_SEEN) return 0;
            curly_bracket_fifo--;  
        }
        if (s[i] == ')') {
            j--;
            if (j<0) return 0;        
            if (correct_order[j] != REGULAR_LAS_SEEN) return 0;
            regular_bracket_fifo--;  
        }
        if (s[i] == ']') {
            j--;
            if (j<0) return 0;
            if (correct_order[j] != SQUARE_LAST_SEEN) return 0;
            square_bracket_fifo--;     
        }
    }
    if ((regular_bracket_fifo == 0) && (square_bracket_fifo == 0) && (curly_bracket_fifo == 0)) {
        return 1;
    }
    else {
        return 0;
    }

}
struct ListNode* mergeTwoLists(struct ListNode* l1, struct ListNode* l2){
    struct ListNode* res=NULL;
    if(l1==NULL)
        return l2;
    else if(l2==NULL)
        return l1;
    if(l1->val <= l2->val){
        res=l1;
        res->next = mergeTwoLists(l1->next,l2);
    }
    else{
        res=l2;
       res->next = mergeTwoLists(l1,l2->next);
    }
    return res;
        
    
}

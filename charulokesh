    if(head==NULL || (head->next==NULL)){
        return NULL;
    }
    int i=0,a;
    struct ListNode *temp,*d;
    temp=head;
    while(temp!=NULL){
        i++;
        temp=temp->next;
    }
    if(n==i)
    return head->next;
    temp=head;
    a=i-n-1;
